# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env holds the Supabase keys. The anon key ends up in the app bundle anyway,
# but this is the file someone eventually pastes a service_role key into.
.env
.env*.local
# A Supabase personal access token for setup scripts. Account-level access -
# it must never be committed, and the app itself never needs it.
.supabase-token

# typescript
*.tsbuildinfo

# generated / downloaded
tools/sources/
.expo-export-check/
