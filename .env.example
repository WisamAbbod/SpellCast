# Copy to .env to switch on the global leaderboard AND online slow mode.
# Without these the app runs perfectly well offline: the leaderboard screen
# shows your own history, and slow mode is pass-and-play on one phone.
#
# Setup (free tier, ~5 minutes):
#   1. Create a project at https://database.new
#   2. Authentication -> Sign In / Providers -> enable "Anonymous sign-ins"
#      (it is OFF by default and every write fails silently without it)
#   3. Paste the whole of supabase/schema.sql into the SQL editor and run it.
#      It is re-runnable, so pasting it again after an edit is safe.
#   4. Project Settings -> API -> copy the URL and the anon/publishable key below
#   5. Restart Metro with `npx expo start --clear` (env vars are inlined at build time)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 'auto' (default) uses the global board when the keys above are set.
# 'local' forces device-only, even with keys present.
EXPO_PUBLIC_LEADERBOARD_MODE=auto

# Developer only: stardust handed to YOUR profile, once, for trying the shop.
# Only honoured in development mode (Expo Go / `expo start`) - a release build
# ignores it, so no player can ever receive it. Raise it to be paid the difference.
# EXPO_PUBLIC_DEV_STARDUST=100000
